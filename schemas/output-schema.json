{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Northstar AI Intent Classification Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "order_id",
    "policy_topic",
    "missing_information",
    "clarification_required",
    "escalation_required"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "ORDER_STATUS",
        "RETURNS_REFUNDS",
        "UNKNOWN_UNSUPPORTED"
      ]
    },
    "order_id": {
      "type": ["string", "null"]
    },
    "policy_topic": {
      "type": ["string", "null"],
      "enum": [
        "RETURN_PERIOD",
        "RETURN_CONDITION",
        "START_RETURN",
        "RETURN_APPROVAL",
        "REFUND_TIMING",
        "REFUND_ARRIVAL",
        "DAMAGED_ITEM",
        "WRONG_ITEM",
        "NON_RETURNABLE_ITEMS",
        "DAMAGED_WRONG_ITEM_SHIPPING",
        "OTHER_RETURN_SHIPPING",
        null
      ]
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["order_id"]
      },
      "uniqueItems": true
    },
    "clarification_required": {
      "type": "boolean"
    },
    "escalation_required": {
      "type": "boolean"
    }
  }
}